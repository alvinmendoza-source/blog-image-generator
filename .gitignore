# Auto-downloaded overlay PNGs — re-downloaded from Figma on first use.
# BUT commit the branded panels so LIVE branding survives Figma token expiry
# (live can't re-download once the token expires; empty repo => bare output).
template_assets/*.png
!template_assets/logo_panel_*.png

