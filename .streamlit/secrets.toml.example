# Copy this file to secrets.toml (same folder) and fill in your keys.
# On Streamlit Cloud, paste the content into App Settings → Secrets instead.

GOOGLE_API_KEY      = "your-gemini-api-key"
KIE_API_KEY         = "your-kie-api-key"
FIGMA_ACCESS_TOKEN  = "your-figma-token"
WEBFLOW_API_KEY     = "your-webflow-site-token"
